# Copy to .env and fill in. Never commit .env.
# Model provider: anthropic (default) or gemini. Only the matching key is required.
DEVPILOT_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_API_KEY=your-google-ai-studio-key
GITHUB_TOKEN=your-github-token

# Optional overrides (defaults shown). The default model depends on the provider:
# claude-sonnet-5-5 for anthropic, gemini-3.6-flash for gemini.
DEVPILOT_MODEL=claude-sonnet-5-5
DEVPILOT_EFFORT=medium
DEVPILOT_MAX_STEPS=40
DEVPILOT_MAX_COST_USD=2.00
DEVPILOT_MAX_TOKENS=1500000
DEVPILOT_COMMAND_TIMEOUT=120
DEVPILOT_SANDBOX_IMAGE=python:3.12-slim
DEVPILOT_SANDBOX_NETWORK=false
DEVPILOT_RUNS_DIR=runs
DEVPILOT_WORKSPACE_DIR=workspace
