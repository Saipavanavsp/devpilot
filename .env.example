# Copy to .env and fill in. Never commit .env.
# Model provider: anthropic (default), gemini, or ollama (free local models, no key needed).
# Only the matching key is required.
DEVPILOT_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_API_KEY=your-google-ai-studio-key
GITHUB_TOKEN=your-github-token

# Ollama: plain http is only allowed to this machine; use https for a remote server.
# OLLAMA_URL=http://localhost:11434
# DEVPILOT_OLLAMA_NUM_CTX=32768

# Optional overrides (defaults shown). The default model depends on the provider:
# claude-sonnet-5-5 for anthropic, gemini-3.6-flash for gemini, qwen3:8b for ollama.
DEVPILOT_MODEL=claude-sonnet-5-5
DEVPILOT_EFFORT=medium
DEVPILOT_MAX_STEPS=40
DEVPILOT_MAX_COST_USD=2.00
DEVPILOT_MAX_TOKENS=1500000
DEVPILOT_COMMAND_TIMEOUT=120
# Leave DEVPILOT_SANDBOX_IMAGE unset to use the default python:3.12-slim pinned by digest.
# DEVPILOT_SANDBOX_IMAGE=python:3.12-slim@sha256:...
DEVPILOT_SANDBOX_NETWORK=false
# Install requirements*.txt / pyproject.toml dependencies in a separate setup container
# (the only step with network access) before the agent starts.
DEVPILOT_SANDBOX_INSTALL_DEPS=true
DEVPILOT_RUNS_DIR=runs
DEVPILOT_WORKSPACE_DIR=workspace

# Web UI. A token is required to listen on anything other than 127.0.0.1.
# DEVPILOT_WEB_TOKEN=at-least-16-random-characters
# DEVPILOT_WEB_ALLOWED_REPOS=owner/repo,owner/other-repo
# DEVPILOT_WEB_ALLOWED_HOSTS=devbox.example.com
DEVPILOT_WEB_MAX_JOBS=2
DEVPILOT_WEB_RUNS_PER_HOUR=20
